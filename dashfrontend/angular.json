{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "auth": {
      "projectType": "library",
      "root": "projects/auth",
      "sourceRoot": "projects/auth/src",
      "prefix": "linlo",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": { "tsConfig": "projects/auth/tsconfig.lib.prod.json" },
            "development": { "tsConfig": "projects/auth/tsconfig.lib.json" }
          },
          "defaultConfiguration": "production"
        }
      }
    },
    "shopping": {
      "projectType": "application",
      "root": "projects/shopping",
      "sourceRoot": "projects/shopping/src",
      "prefix": "shopping",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/shopping/src/main.ts",
            "tsConfig": "projects/shopping/tsconfig.app.json",
            "index": "projects/shopping/src/index.html",
            "polyfills": ["zone.js"],
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/shopping/public",
                "output": "/"
              }
            ],
            "styles": ["projects/shopping/src/styles.css"]
          },
          "configurations": {
            "production": { "outputHashing": "all" },
            "development": { "optimization": false, "sourceMap": true }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": { "buildTarget": "shopping:build:production" },
            "development": { "buildTarget": "shopping:build:development" }
          },
          "defaultConfiguration": "development"
        }
      }
    },
    "auth-demo": {
      "projectType": "application",
      "root": "projects/auth-demo",
      "sourceRoot": "projects/auth-demo/src",
      "prefix": "auth-demo",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/auth-demo/src/main.ts",
            "tsConfig": "projects/auth-demo/tsconfig.app.json",
            "index": "projects/auth-demo/src/index.html",
            "polyfills": ["zone.js"],
            "assets": [],
            "styles": ["projects/auth-demo/src/styles.css"]
          },
          "configurations": {
            "production": { "outputHashing": "all" },
            "development": { "optimization": false, "sourceMap": true }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": { "buildTarget": "auth-demo:build:production" },
            "development": { "buildTarget": "auth-demo:build:development" }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
