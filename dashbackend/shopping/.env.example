# Config esterna di shopping: valori letti da docker-compose (env_file), NON copiati nell'immagine.
# Copia questo file in ".env" nella stessa cartella e personalizzalo (il ".env" reale non va committato).

DB_URL=jdbc:postgresql://pg-linlodash:5432/linlodash
DB_USER=shopping
DB_PASSWORD=shopping-change-me
DB_SCHEMA=shopping
DDL_AUTO=update

# Deve essere lungo almeno 32 caratteri. In produzione usare un secret manager, non un file in chiaro.
JWT_SECRET=change-me-in-production-min-32-chars-shopping
