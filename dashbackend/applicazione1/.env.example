# Config esterna di applicazione1: valori letti da docker-compose (env_file), NON copiati nell'immagine.
# Copia questo file in ".env" nella stessa cartella e personalizzalo (il ".env" reale non va committato).

DB_URL=jdbc:postgresql://postgres-app1:5432/linlodash
DB_USER=app1
DB_PASSWORD=app1-change-me
DB_SCHEMA=applicazione1
DDL_AUTO=update

# Deve essere lungo almeno 32 caratteri. In produzione usare un secret manager, non un file in chiaro.
JWT_SECRET=change-me-in-production-min-32-chars-app1
